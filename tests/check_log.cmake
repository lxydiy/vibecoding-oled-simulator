execute_process(COMMAND "${EXECUTABLE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result STREQUAL "0" OR NOT output STREQUAL "PASS\n")
    message(FATAL_ERROR "Log test failed: ${result}; ${output}; ${errors}")
endif()
string(REGEX REPLACE "\\([0-9]+\\)" "(time)" normalized "${errors}")
if(MODE STREQUAL "full")
    set(expected "E (time) test: value=1\nW (time) test: value=2\nI (time) test: value=3\nD (time) test: value=4\nV (time) test: value=5\n")
else()
    set(expected "W (time) test: value=1\nI (time) test: value=2\n")
endif()
string(APPEND expected "I (time) generic: hello\nI (time) other: second translation unit\n")
if(NOT normalized STREQUAL expected)
    message(FATAL_ERROR "Unexpected log formatting/filtering: ${errors}")
endif()
